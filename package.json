{
  "name": "bioluma",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Personal site of Babak Bayat, built as an interactive bioluminescent descent. Runs as a Cloudflare Worker.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite build && wrangler dev",
    "deploy": "vite build && wrangler deploy",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly false",
    "cf-typegen": "wrangler types",
    "db:schema:local": "wrangler d1 execute bioluma-db --local --file=./db/schema.sql",
    "db:seed:local": "wrangler d1 execute bioluma-db --local --file=./db/seed.sql",
    "db:schema": "wrangler d1 execute bioluma-db --remote --file=./db/schema.sql",
    "db:seed": "wrangler d1 execute bioluma-db --remote --file=./db/seed.sql",
    "hash": "node scripts/hash-password.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.1.2",
    "@react-three/fiber": "^9.1.2",
    "@react-three/postprocessing": "^3.0.4",
    "clsx": "^2.1.1",
    "hono": "^4.7.11",
    "marked": "^15.0.12",
    "motion": "^12.15.0",
    "postprocessing": "^6.37.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router": "^7.6.2",
    "three": "^0.176.0",
    "zod": "^3.25.42",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.2.4",
    "@cloudflare/workers-types": "^4.20250528.0",
    "@tailwindcss/vite": "^4.1.8",
    "@types/node": "^22.15.24",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "@types/three": "^0.176.0",
    "@vitejs/plugin-react": "^4.5.0",
    "tailwindcss": "^4.1.8",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "wrangler": "^4.18.0"
  },
  "engines": {
    "node": ">=20"
  }
}
