{
  "$schema": "node_modules/wrangler/config-schema.json",

  // Cloudflare WORKER (not Pages). Static assets ride along with the Worker,
  // but the Worker runs first so it can inject per-route SEO metadata.
  "name": "bioluma",
  "main": "src/worker/index.ts",
  "compatibility_date": "2025-05-01",
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": true
  },

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },

  "vars": {
    "SITE_URL": "https://babakbayat.dev",
    "SITE_NAME": "Babak Bayat",
    "CONTACT_EMAIL": "aghababaky@gmail.com",
    "ENVIRONMENT": "production"
  },

  // Replace every placeholder id below with the ids wrangler prints when you
  // run the create commands in the README. Ids are not secrets.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bioluma-db",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "db/migrations"
    }
  ],

  "kv_namespaces": [
    {
      "binding": "SESSIONS",
      "id": "REPLACE_WITH_KV_NAMESPACE_ID"
    }
  ],

  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "bioluma-media"
    }
  ]

  // Secrets are never in this file. Set them with:
  //   wrangler secret put SESSION_SECRET
}
